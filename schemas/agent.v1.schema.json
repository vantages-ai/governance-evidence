{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vantages.app/schemas/agent.v1.schema.json",
  "title": "VOS Acta Agent Manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "app_id",
    "organization",
    "canonical_url",
    "jurisdictions",
    "risk_tier",
    "oversight_mode",
    "approvals_policy"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "app_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "organization": { "type": "string", "minLength": 1 },
    "canonical_url": { "type": "string", "format": "uri" },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["eu", "us", "global"] }
    },
    "risk_tier": { "type": "string", "minLength": 1 },
    "oversight_mode": { "type": "string", "minLength": 1 },
    "approvals_policy": { "type": "string", "minLength": 1 },
    "sigil_badge_url": { "type": "string" },
    "verify_url": { "type": "string" }
  }
}
